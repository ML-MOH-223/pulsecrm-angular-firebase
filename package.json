{
  "name": "pulse-crm",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && npm --prefix functions run build",
    "format:check": "prettier --check \"src/**/*.ts\" \"functions/src/**/*.ts\"",
    "check": "npm run lint && npm run typecheck && npm run test:ci && npm run build"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "firebase": "^11.10.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.74.0"
  }
}
