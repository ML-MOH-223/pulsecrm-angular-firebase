rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isAuthenticated()
        && data.ownerId is string
        && data.ownerId == request.auth.uid;
    }

    function keepsImmutableOwner() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    function isValidContact(data) {
      return data.firstName is string && data.firstName.size() > 0
        && data.lastName is string && data.lastName.size() > 0
        && data.email is string && data.email.size() > 3
        && data.company is string
        && data.status in ['lead', 'qualified', 'customer', 'churned']
        && data.ownerId is string && data.ownerId.size() > 0;
    }

    function isValidDeal(data) {
      return data.title is string && data.title.size() > 0
        && data.company is string
        && data.amount is number && data.amount >= 0
        && data.probability is number && data.probability >= 0 && data.probability <= 100
        && data.stage in ['prospection', 'qualification', 'proposition', 'negociation', 'gagne', 'perdu']
        && data.ownerId is string && data.ownerId.size() > 0;
    }

    function isValidActivity(data) {
      return data.contactId is string && data.contactId.size() > 0
        && data.type in ['appel', 'email', 'reunion', 'note']
        && data.summary is string && data.summary.size() > 0
        && data.authorName is string
        && data.ownerId is string && data.ownerId.size() > 0;
    }

    // Contacts : lecture, création, modification et suppression strictement limitées au propriétaire (ownerId)
    match /contacts/{contactId} {
      allow read: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data) && isValidContact(request.resource.data);
      allow update: if isOwner(resource.data) && keepsImmutableOwner() && isValidContact(request.resource.data);
      allow delete: if isOwner(resource.data);
    }

    // Deals (Opportunités) : strictement limités au propriétaire (ownerId)
    match /deals/{dealId} {
      allow read: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data) && isValidDeal(request.resource.data);
      allow update: if isOwner(resource.data) && keepsImmutableOwner() && isValidDeal(request.resource.data);
      allow delete: if isOwner(resource.data);
    }

    // Activities (Journal commercial) : strictement limitées au propriétaire (ownerId)
    match /activities/{activityId} {
      allow read: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data) && isValidActivity(request.resource.data);
      allow update: if isOwner(resource.data) && keepsImmutableOwner() && isValidActivity(request.resource.data);
      allow delete: if isOwner(resource.data);
    }

    // Bloquer tout autre document par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
