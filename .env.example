# ==============================================================================
# PulseCRM (Angular 19 + Firebase) — Example Environment Configuration
# ==============================================================================
# IMPORTANT :
# - PulseCRM est une SPA Angular (pas Vite ni Next.js : aucun préfixe VITE_ ou
#   NEXT_PUBLIC_ n'est lu automatiquement par Angular).
# - La configuration Firebase Web est injectée via :
#     - src/environments/environment.ts (production / Vercel)
#     - src/environments/environment.development.ts (développement local)
# - Ces valeurs sont des identifiants clients publics Firebase (jamais de clé
#   privée Admin SDK ni de secret serveur ici). La sécurité est assurée par
#   firestore.rules + restriction par référent HTTP dans Google Cloud Console.
# ==============================================================================

FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
